<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/title_bar" />

    <!-- One focusable view; the D-pad moves the selected day inside it. -->
    <com.turbocal.app.ui.month.MonthGridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:focusable="true"
        android:focusableInTouchMode="false" />

    <TextView
        android:id="@+id/summary"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/surface"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_meta" />

    <include layout="@layout/softkey_bar" />
</LinearLayout>
