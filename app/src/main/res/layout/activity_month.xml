<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/tcBackground"
    android:orientation="vertical">

    <include layout="@layout/title_bar" />

    <!-- One focusable view; the D-pad moves the selected day inside it. -->
    <com.turbocal.app.ui.month.MonthGridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="@dimen/month_grid_min_height"
        android:focusable="true"
        android:focusableInTouchMode="false" />

    <!-- Every event of the focused day, filled in code. It is as tall as that day needs;
         the grid gives up only that much, never below month_grid_min_height. -->
    <LinearLayout
        android:id="@+id/day_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/tcSurface"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter" />

    <include layout="@layout/softkey_bar" />
</LinearLayout>
