<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/tcBackground"
    android:orientation="vertical">

    <include layout="@layout/title_bar" />

    <!-- One focusable view; the D-pad moves the selected day inside it. -->
    <com.turbocal.app.ui.month.MonthGridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:focusable="true"
        android:focusableInTouchMode="false" />

    <!-- The focused day's events: a header plus 3 to 5 lines (at least 3 lines tall, at most 5
         filled in code, the 5th becoming "+N more" past that). The grid takes the rest. -->
    <LinearLayout
        android:id="@+id/day_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/day_info_min_height"
        android:background="?attr/tcSurface"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter" />

    <include layout="@layout/softkey_bar" />
</LinearLayout>
