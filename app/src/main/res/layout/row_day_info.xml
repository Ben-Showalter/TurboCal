<?xml version="1.0" encoding="utf-8"?>
<!-- One line in the month view's day info: colour bar, time, title. Not focusable. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/day_info_line"
    android:focusable="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <View
        android:id="@+id/color_bar"
        android:layout_width="@dimen/color_bar"
        android:layout_height="match_parent"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:maxLines="1"
        android:textColor="?attr/tcTextSecondary"
        android:textSize="@dimen/text_meta" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/tcTextPrimary"
        android:textSize="@dimen/text_meta" />
</LinearLayout>
