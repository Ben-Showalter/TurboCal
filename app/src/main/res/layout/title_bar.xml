<?xml version="1.0" encoding="utf-8"?>
<!-- Screen title and a fixed-height one-line status, so the layout never jumps (guide §4). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/tcSurfaceHeader"
    android:focusable="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/gutter"
    android:paddingEnd="@dimen/gutter">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/tcTextPrimary"
        android:textSize="@dimen/text_header" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/tcTextSecondary"
        android:textSize="11sp" />
</LinearLayout>
