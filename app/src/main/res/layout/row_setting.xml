<?xml version="1.0" encoding="utf-8"?>
<!-- Settings row: optional colour bar (calendars), title, one status/value line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/row_min_height"
    android:orientation="horizontal">

    <View
        android:id="@+id/color_bar"
        android:layout_width="@dimen/color_bar"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingTop="3dp"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/tcTextPrimary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/tcTextSecondary"
            android:textSize="@dimen/text_meta" />
    </LinearLayout>
</LinearLayout>
