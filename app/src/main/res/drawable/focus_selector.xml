<?xml version="1.0" encoding="utf-8"?>
<!-- The same highlight for buttons, fields and single rows (not inside a ListView). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/focus_highlight" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
        </shape>
    </item>
</selector>
