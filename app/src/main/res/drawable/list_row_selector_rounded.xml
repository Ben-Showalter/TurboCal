<?xml version="1.0" encoding="utf-8"?>
<!-- list_row_selector with rounded corners: Week, Day and Agenda (CalendarActivity.useRoundedSelector). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/focus_highlight_rounded" />
    <item android:state_pressed="true" android:drawable="@drawable/focus_highlight_rounded" />
    <item android:state_selected="true" android:drawable="@drawable/focus_highlight_rounded" />
    <item android:drawable="@android:color/transparent" />
</selector>
